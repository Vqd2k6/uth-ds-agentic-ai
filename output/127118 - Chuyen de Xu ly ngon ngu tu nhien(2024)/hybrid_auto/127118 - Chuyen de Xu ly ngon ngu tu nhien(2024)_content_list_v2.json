                311,
                672,
                347
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "✓ CO3: Đánh giá và áp dụng các công nghệ, chiến lược mới trong lĩnh vực NLP để giải quyết các bài toán thực tế."
                    }
                ]
            },
            "bbox": [
                100,
                351,
                670,
                385
