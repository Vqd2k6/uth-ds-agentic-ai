            },
            "bbox": [
                137,
                674,
                712,
                692
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "- Cách thức triển khai một hợp đồng thông minh trên mạng Blockchain."
                    }
                ]
            },
            "bbox": [
                137,
                694,
                781,
                713
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "- Xây dựng một ứng dụng phi tập trung với Blockchain và hợp đồng thông minh"
