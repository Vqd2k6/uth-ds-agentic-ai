                },
                "table_caption": [],
                "table_footnote": [],
                "html": "<table><tr><td>Tên học phần</td><td colspan=\"3\">Tiếng Việt: CẤU TRÚC HỆ THÔNG MẠNG LUỐI BLOCKCHAINTiếng Anh: BLOCKCHAIN NETWORK SYSTEM STRUCTURE</td><td>Mã HP:127112</td></tr><tr><td>Số tín chỉ</td><td colspan=\"4\">3 (2, 1, 3)</td></tr><tr><td rowspan=\"2\">Phân bổ thời gian</td><td>LT/BT/DA</td><td>TH/TN/TL</td><td>Tổng</td><td>Tự học</td></tr><tr><td>30</td><td>30</td><td>60</td><td>90</td></tr><tr><td>Thang điểm</td><td colspan=\"4\">10</td></tr><tr><td>HP tiên quyết</td><td colspan=\"4\"></td></tr><tr><td>HP học trước</td><td colspan=\"4\">Lập trình Blockchain và hợp đồng thông minh</td></tr><tr><td>HP song hành</td><td colspan=\"4\"></td></tr><tr><td>Loại học phần</td><td colspan=\"4\">☐ Bắt buộc ☑ Tự chọn bắt buộc ☐ Tự chọn tự do</td></tr><tr><td>Thuộc thành phần</td><td colspan=\"4\">Chuyên ngành</td></tr></table>",
