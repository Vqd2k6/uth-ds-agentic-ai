                468,
                833
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "CO1 Áp dụng kiến thức toán, khoa học tự nhiên vào chuyên ngành KHDL"
                    }
                ]
            },
            "bbox": [
                149,
                840,
                821,
                860
            ]
        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "CO2 Giải quyết các bài toán kỹ thuật nhiều thông số ràng buộc đầu vào thuộc chuyên ngành KHDL bằng phương pháp cụ thể; Đánh giá các giải pháp khả thi và lựa chọn giải pháp tối ưu cho từng bài toán kỹ thuật chuyên ngành KHDL cụ thể."
                    }
                ]
            },
            "bbox": [
                147,
                860,
                924,
                923
            ]
        }
